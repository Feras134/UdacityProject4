   "source": [
    "# ═════════════════════════════════════════════\n",
    "# III. USER-USER COLLABORATIVE FILTERING\n",
    "# ═════════════════════════════════════════════\n",
    " \n",
    "# Since the dataset contains only article content (no explicit\n",
    "# user-interaction log), we simulate a user-article matrix by\n",
    "# assigning each article to a topic cluster (via SVD below) and\n",
    "# treating each topic as a user \"neighborhood\".\n",
    "#\n",
    "# In a real deployment:\n",
    "#   - Build a sparse matrix: rows = users, cols = articles, values = interactions\n",
    "#   - Compute user-user cosine similarity on that matrix\n",
    "#   - For a target user, find k nearest neighbors\n",
    "#   - Recommend articles those neighbors interacted with that the target hasn't\n",
    " \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "825692ff",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Placeholder: demonstrate the pattern with a small synthetic matrix\n",
    "np.random.seed(42)\n",
    "n_users    = 8\n",
    "n_articles = len(df)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "b3319072",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Synthetic binary interaction matrix (1 = read, 0 = not read)\n",
    "user_item = np.random.randint(0, 2, size=(n_users, n_articles))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "05fe4124",
   "metadata": {},
   "outputs": [],
   "source": [
    "# User-user cosine similarity\n",
    "user_sim = cosine_similarity(user_item)\n",
    "np.fill_diagonal(user_sim, 0)   # exclude self-similarity"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "9b440731",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "User-user recommendations for user 0:\n",
      "                                                                 doc_full_name  article_id\n",
      "0                   Detect Malfunctioning IoT Sensors with Streaming Analytics           0\n",
      "512                        Put a human face on machine learning with WML & DSX         511\n",
      "3     DataLayer Conference: Boost the performance of your distributed database           3\n",
      "515                                            Coding for Eventual Consistency         514\n",
      "1028         How to move data with Compose Transporter - From database to disk        1023\n"
     ]
    }
   ],
   "source": [
    "def get_user_recommendations(user_id, user_item, user_sim, df, n=5):\n",
    "    \"\"\"\n",
    "    For a given user, find the most similar neighbor and recommend\n",
    "    articles that neighbor read but the target user has not.\n",
    "    \"\"\"\n",
    "    similar_user = np.argmax(user_sim[user_id])\n",
    "    already_read = set(np.where(user_item[user_id] == 1)[0])\n",
    "    neighbor_read = set(np.where(user_item[similar_user] == 1)[0])\n",
    "    candidates = list(neighbor_read - already_read)[:n]\n",
    "    return df.iloc[candidates][['doc_full_name', 'article_id']]\n",
    " \n",
    "print(\"\\nUser-user recommendations for user 0:\")\n",
    "print(get_user_recommendations(0, user_item, user_sim, df).to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6371274c",
   "metadata": {},
   "source": [
    "# ═════════════════════════════════════════════\n",
    "# IV. CONTENT-BASED RECOMMENDATIONS (TF-IDF)\n",
    "# ═════════════════════════════════════════════"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "99264671",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Combine title + description into a single text field\n",
    "df['content'] = (\n",
    "    df['doc_full_name'].fillna('') + ' ' +\n",
    "    df['doc_description'].fillna('')\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "d824287a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "TF-IDF matrix shape: (1056, 500)\n"
     ]
    }
   ],
   "source": [
    "# Build TF-IDF matrix\n",
    "tfidf    = TfidfVectorizer(max_features=500, stop_words='english')\n",
    "tfidf_matrix = tfidf.fit_transform(df['content'])\n",
    " \n",
    "print(f\"TF-IDF matrix shape: {tfidf_matrix.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "24db363a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Content recommendations for article 0:\n",
      "  Source: Detect Malfunctioning IoT Sensors with Streaming Analytics\n",
      "                                                    doc_full_name  article_id  similarity\n",
      "471      What’s new in the Streaming Analytics service on Bluemix         470      0.5751\n",
      "732            Developing for the IBM Streaming Analytics service         730      0.5286\n",
      "1010  Real-time Sentiment Analysis of Twitter Hashtags with Spark        1005      0.4797\n",
      "194                Data science for real-time streaming analytics         194      0.4707\n",
      "652                    Analyzing streaming Data from Kafka Topics         651      0.4568\n",
      "\n",
      "Content recommendations for article 9 (Apache Spark):\n",
      "  Source: Using Apache Spark to predict attack vectors among billions of users and trillions of events\n",
      "                                                                    doc_full_name  article_id  similarity\n",
      "55   Predict Flight Delays with Apache Spark MLLib, FlightStats, and Weather Data          55      0.4621\n",
      "284      Apache Spark 2.0: Machine Learning. Under the Hood and Over the Rainbow.         284      0.4200\n",
      "852                Humans vs. Apache Spark: Building our Rock-Paper-Scissors game         849      0.4094\n",
      "390                       Apache Spark™ 2.0: Impressive Improvements to Spark SQL         389      0.3845\n",
      "593                                                        Apache Spark Analytics         592      0.3822\n"
     ]
    }
   ],
   "source": [
    "# Pairwise cosine similarity\n",
    "cosine_sim = cosine_similarity(tfidf_matrix, tfidf_matrix)\n",
    " \n",
    "def get_content_recommendations(article_idx, cosine_sim=cosine_sim, df=df, n=5):\n",
    "    \"\"\"\n",
    "    Return the top-n articles most similar to the given article index,\n",
    "    ranked by cosine similarity on TF-IDF vectors.\n",
    "    \"\"\"\n",
    "    sim_scores = list(enumerate(cosine_sim[article_idx]))\n",
    "    sim_scores = sorted(sim_scores, key=lambda x: x[1], reverse=True)\n",
    "    sim_scores = sim_scores[1:n+1]          # exclude the article itself\n",
    "    indices    = [i for i, _ in sim_scores]\n",
    "    scores     = [round(s, 4) for _, s in sim_scores]\n",
    "    result     = df.iloc[indices][['doc_full_name', 'article_id']].copy()\n",
    "    result['similarity'] = scores\n",
    "    return result\n",
    " \n",
    "print(\"\\nContent recommendations for article 0:\")\n",
    "print(f\"  Source: {df.iloc[0]['doc_full_name']}\")\n",
    "print(get_content_recommendations(0).to_string())\n",
    " \n",
    "print(\"\\nContent recommendations for article 9 (Apache Spark):\")\n",
    "print(f\"  Source: {df.iloc[9]['doc_full_name']}\")\n",
    "print(get_content_recommendations(9).to_string())"
   ]
  },
  {
