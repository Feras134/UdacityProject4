    "# SVD-based article recommendation:\n",
    "# Compute cosine similarity in the reduced latent space\n",
    "latent_sim = cosine_similarity(latent_matrix, latent_matrix)\n",
    " \n",
    "def get_svd_recommendations(article_idx, latent_sim=latent_sim, df=df, n=5):\n",
    "    \"\"\"\n",
    "    Recommend articles by cosine similarity in the SVD latent space.\n",
    "    \"\"\"\n",
    "    sim_scores = list(enumerate(latent_sim[article_idx]))\n",
    "    sim_scores = sorted(sim_scores, key=lambda x: x[1], reverse=True)\n",
    "    sim_scores = sim_scores[1:n+1]\n",
    "    indices    = [i for i, _ in sim_scores]\n",
    "    scores     = [round(s, 4) for _, s in sim_scores]\n",
    "    result     = df.iloc[indices][['doc_full_name', 'article_id']].copy()\n",
    "    result['latent_similarity'] = scores\n",
    "    return result\n",
    " \n",
    "print(\"\\nSVD-based recommendations for article 0:\")\n",
    "print(f\"  Source: {df.iloc[0]['doc_full_name']}\")\n",
    "print(get_svd_recommendations(0).to_string())"
   ]
