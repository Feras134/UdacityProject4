   "source": [
    "# ═════════════════════════════════════════════\n",
    "# V. MATRIX FACTORIZATION (TruncatedSVD)\n",
    "# ═════════════════════════════════════════════"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "fa02050e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Latent matrix shape: (1056, 10)\n"
     ]
    }
   ],
   "source": [
    "N_COMPONENTS = 10\n",
    " \n",
    "svd = TruncatedSVD(n_components=N_COMPONENTS, random_state=42)\n",
    "latent_matrix = svd.fit_transform(tfidf_matrix)\n",
    " \n",
    "print(f\"Latent matrix shape: {latent_matrix.shape}\")   # (articles, components)"
   ]
  },
